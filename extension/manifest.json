{
  "manifest_version": 3,
  "name": "SyncWatch",
  "version": "0.7.0",
  "minimum_chrome_version": "111",
  "description": "Watch any web video in sync with friends, with chat. Works on most HTML5 players.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "SyncWatch: show or hide chat" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/fs-main.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/invite.js"],
      "all_frames": false,
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["icons.js", "content/video.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["icons.js", "content/ui.js"],
      "all_frames": false,
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["icons.js", "content/media-ui.js"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["chat/chat.html", "chat/chat.js", "stage/stage.html", "stage/stage.js", "stage/mesh.js", "icons.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
